{
  "name": "douyin-fan-ranker",
  "version": "0.1.0",
  "private": true,
  "description": "本地运行的抖音粉丝分析原型：监听浏览器已产生的粉丝列表 Response，去重并按粉丝数排序，导出 CSV / JSON。",
  "type": "commonjs",
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "playwright": "^1.47.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "jsdom": "^24.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
